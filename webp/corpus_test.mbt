  b"\x00\x00"

///|
test "matches dwebp on a corpus of encoder output" {
  let cases : Array[(String, Bytes, Int, Int, UInt)] = [
    ("1x1", corpus_dot, 1, 1, 0x16c70cdbU),
    ("3x1", corpus_row3, 3, 1, 0xd23d11e1U),
    ("1x7", corpus_column7, 1, 7, 0x8e8ad749U),
    ("7x5", corpus_odd7x5, 7, 5, 0xa83a8e59U),
    ("16x16 palette", corpus_palette16, 16, 16, 0xc06022c5U),
    ("40x37 gradient", corpus_gradient40x37, 40, 37, 0xb5c4b7dfU),
    ("16x16 noise", corpus_noise16, 16, 16, 0xb5fe50a8U),
    ("300x1", corpus_wide300, 300, 1, 0xb14d5454U),
    ("12x12 alpha", corpus_alpha12, 12, 12, 0xffcec2edU),
  ]
  for case in cases {
    let (name, bytes, width, height, digest) = case
    let image = @webp.decode_webp(bytes)
    @test.assert_eq(image.width, width, msg=name)
    @test.assert_eq(image.height, height, msg=name)
    @test.assert_eq(corpus_digest(image.pixels), digest, msg=name)
  }
}

///|
test "reads the alpha plane of a lossy sample (8x8 lossy with alpha)" {
  let bytes = corpus_lossy8
  let plane = @webp.decode_alpha(bytes)
  @test.assert_eq(plane.width, 8)
  @test.assert_eq(plane.height, 8)
  @test.assert_eq(corpus_plane_digest(plane.values), 0xc750f405U)
  let err = @test.expect_error(() => @webp.decode_webp(bytes))
  @test.assert_eq(err, @webp.DecodeError::UnsupportedLossyImage)
}
