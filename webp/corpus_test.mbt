///|
// Encoder output checked against dwebp 1.6.0: every sample below was
// produced with cwebp and decoded with dwebp, and the digests are the
// FNV-1a hash of the ARGB pixels dwebp wrote. The test only needs the
// bytes, so CI reproduces the comparison without either tool.

///|
/// FNV-1a over the four bytes of every pixel, most significant first.
fn corpus_digest(pixels : Array[UInt]) -> UInt {
  let mut value = 2166136261U
  for pixel in pixels {
    for shift in [24, 16, 8, 0] {
      value = (value ^ ((pixel >> shift) & 0xffU)) * 16777619U
    }
  }
  value
}

///|
/// FNV-1a over a byte plane.
fn corpus_plane_digest(values : Bytes) -> UInt {
  let mut value = 2166136261U
  for index in 0..<values.length() {
    value = (value ^ values.at(index).to_uint()) * 16777619U
  }
  value
}

