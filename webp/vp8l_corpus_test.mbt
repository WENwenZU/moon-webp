///|
test "decodes a small cwebp image" {
  let image = @webp.decode_vp8l(
    b"\x2f\x06\x00\x01\x00\xb9\x8c\xe8\x7f\xec\x0a\x1f\xd1\xff\x30\x28" +
    b"\x6a\xdb\x06\x7a\x16\x40\xf9\xb3\x3d\xc7\x60\x22\xc8\xb6\x0d\x6d" +
    b"\x3b\xc1\xfb\x10\x13\xf0\xb8\xe4\x4e\x00",
  )
  @test.assert_eq(image.width, 7)
  @test.assert_eq(image.height, 5)
  @test.assert_eq(image.pixels, [
    0xff000000U, 0xff11070bU, 0xff220e16U, 0xff331521U, 0xff441c2cU, 0xff552337U,
    0xff662a42U, 0xff031305U, 0xff141a10U, 0xff25211bU, 0xff362826U, 0xff472f31U,
    0xff58363cU, 0xff693d47U, 0xff06260aU, 0xff172d15U, 0xff283420U, 0xff393b2bU,
    0xff4a4236U, 0xff5b4941U, 0xff6c504cU, 0xff09390fU, 0xff1a401aU, 0xff2b4725U,
    0xff3c4e30U, 0xff4d553bU, 0xff5e5c46U, 0xff6f6351U, 0xff0c4c14U, 0xff1d531fU,
    0xff2e5a2aU, 0xff3f6135U, 0xff506840U, 0xff616f4bU, 0xff727656U,
  ])
}
