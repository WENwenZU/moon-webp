    0xff537b45U, 0xff648250U, 0xff75895bU, 0xff869066U, 0xff979771U, 0xffa89e7cU,
    0xffb9a587U, 0xffcaac92U, 0xffdbb39dU, 0xffecbaa8U, 0xfffdc1b3U, 0xff0ec8beU,
    0xff12721eU, 0xff237929U, 0xff348034U, 0xff45873fU, 0xff568e4aU, 0xff679555U,
    0xff789c60U, 0xff89a36bU, 0xff9aaa76U, 0xffabb181U, 0xffbcb88cU, 0xffcdbf97U,
    0xffdec6a2U, 0xffefcdadU, 0xff00d4b8U, 0xff11dbc3U, 0xff158523U, 0xff268c2eU,
    0xff379339U, 0xff489a44U, 0xff59a14fU, 0xff6aa85aU, 0xff7baf65U, 0xff8cb670U,
    0xff9dbd7bU, 0xffaec486U, 0xffbfcb91U, 0xffd0d29cU, 0xffe1d9a7U, 0xfff2e0b2U,
