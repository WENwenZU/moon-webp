///|
test "keeps translucent pixels from a cwebp image" {
  let image = @webp.decode_vp8l(
    b"\x2f\x0f\xc0\x03\x10\xb9\x0a\x44\xf4\x3f\x76\x85\x8f\xe8\x7f\x80" +
    b"\x48\xdb\x66\x6c\x02\xe6\x5f\xef\xe1\x29\x41\xb6\x6d\x68\xdb\x09" +
    b"\x3e\x0f\x6a\xda\x36\x60\xb1\x72\x77\x26\xc0\xff\x6a\x75\x17\x00",
  )
  @test.assert_eq(image.width, 16)
  @test.assert_eq(image.height, 16)
  @test.assert_eq(image.pixels, [
    0x00000000U, 0x1011070bU, 0x20220e16U, 0x30331521U, 0x40441c2cU, 0x50552337U,
    0x60662a42U, 0x7077314dU, 0x80883858U, 0x90993f63U, 0xa0aa466eU, 0xb0bb4d79U,
    0xc0cc5484U, 0xd0dd5b8fU, 0xe0ee629aU, 0xf0ff69a5U, 0x0b031305U, 0x1b141a10U,
    0x2b25211bU, 0x3b362826U, 0x4b472f31U, 0x5b58363cU, 0x6b693d47U, 0x7b7a4452U,
    0x8b8b4b5dU, 0x9b9c5268U, 0xabad5973U, 0xbbbe607eU, 0xcbcf6789U, 0xdbe06e94U,
    0xebf1759fU, 0xfb027caaU, 0x1606260aU, 0x26172d15U, 0x36283420U, 0x46393b2bU,
    0x564a4236U, 0x665b4941U, 0x766c504cU, 0x867d5757U, 0x968e5e62U, 0xa69f656dU,
