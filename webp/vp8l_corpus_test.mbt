///|
// Samples produced by cwebp 1.6.0 (`-lossless -exact`) from images built for
// this test, then decoded with dwebp 1.6.0 as PAM. They exercise the encoder's
// own choice of transforms, color cache, and prefix codes.

///|
test "decodes a cwebp gradient with predictor and subtract green" {
  let image = @webp.decode_vp8l(
    b"\x2f\x0f\xc0\x03\x00\xcd\x65\x44\xff\x63\x57\xfd\x52\x44\xff\xc3" +
    b"\x40\xa4\x6d\x03\x27\x60\xfe\xf5\x0e\x9e\x3e\x57\x80\x8f\x98\x80" +
    b"\xa3\x7a\x2e\x00",
  )
  @test.assert_eq(image.width, 16)
  @test.assert_eq(image.height, 16)
  @test.assert_eq(image.pixels, [
    0xff000000U, 0xff11070bU, 0xff220e16U, 0xff331521U, 0xff441c2cU, 0xff552337U,
    0xff662a42U, 0xff77314dU, 0xff883858U, 0xff993f63U, 0xffaa466eU, 0xffbb4d79U,
    0xffcc5484U, 0xffdd5b8fU, 0xffee629aU, 0xffff69a5U, 0xff031305U, 0xff141a10U,
    0xff25211bU, 0xff362826U, 0xff472f31U, 0xff58363cU, 0xff693d47U, 0xff7a4452U,
    0xff8b4b5dU, 0xff9c5268U, 0xffad5973U, 0xffbe607eU, 0xffcf6789U, 0xffe06e94U,
    0xfff1759fU, 0xff027caaU, 0xff06260aU, 0xff172d15U, 0xff283420U, 0xff393b2bU,
    0xff4a4236U, 0xff5b4941U, 0xff6c504cU, 0xff7d5757U, 0xff8e5e62U, 0xff9f656dU,
    0xffb06c78U, 0xffc17383U, 0xffd27a8eU, 0xffe38199U, 0xfff488a4U, 0xff058fafU,
    0xff09390fU, 0xff1a401aU, 0xff2b4725U, 0xff3c4e30U, 0xff4d553bU, 0xff5e5c46U,
    0xff6f6351U, 0xff806a5cU, 0xff917167U, 0xffa27872U, 0xffb37f7dU, 0xffc48688U,
    0xffd58d93U, 0xffe6949eU, 0xfff79ba9U, 0xff08a2b4U, 0xff0c4c14U, 0xff1d531fU,
    0xff2e5a2aU, 0xff3f6135U, 0xff506840U, 0xff616f4bU, 0xff727656U, 0xff837d61U,
    0xff94846cU, 0xffa58b77U, 0xffb69282U, 0xffc7998dU, 0xffd8a098U, 0xffe9a7a3U,
