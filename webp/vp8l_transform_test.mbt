///|
// Fixtures for the level-zero transforms. Each payload was assembled byte by
// byte from RFC 9649 by a separate encoder and then decoded with libwebp
// 1.6.0's dwebp; the expected ARGB values are dwebp's PAM output, so a
// mismatch here means this decoder disagrees with the reference decoder.

///|
test "applies the subtract green transform" {
  let image = @webp.decode_vp8l(
    b"\x2f\x02\x40\x00\x10\x85\xdf\x04\x08\x10\x00\x00\x00\xc0\x78\xc4" +
    b"\xff\x27\x4f\xf2\x13\xdf\xf0\x9b\x20\x00\x02\x00\x00\x00\x78\x82" +
    b"\xff\x5f\xe9\x07\xfa\x4d\x10\x00\x01\x00\x00\x00\xf4\x03\xff\xbf" +
    b"\xd2\x13\xfc\x26\x08\x80\x00\x00\x00\x00\xfa\xb9\x9f\x1b\xa9\x5b" +
    b"\x1d\x00\xac\x7d\x3e\x00\x00\x00\x00\x00",
  )
  @test.assert_eq(image.width, 3)
  @test.assert_eq(image.height, 2)
  @test.assert_eq(image.pixels, [
    0xff102030U, 0x80a0b0c0U, 0x00ffffffU, 0xff000000U, 0xff010203U, 0xfff0e0d0U,
  ])
}

///|
test "predicts pixels across tile borders" {
  let image = @webp.decode_vp8l(
    b"\x2f\x05\x00\x01\x10\x81\xf0\x9b\x20\x00\x02\x00\x00\x00\x0c\xba" +
    b"\x89\xff\xbf\xeb\x37\x41\x00\x04\x00\x00\x00\x18\x1c\x44\xf0\xff" +
    b"\x7b\xfb\x1f\x90\xf6\xf0\x9b\x00\x40\x02\x00\x00\x00\x98\x0f\x08" +
    b"\x82\x20\x38\x88\x20\x08\x82\x20\x08\x82\x20\x38\x09\x82\x20\xf8" +
    b"\x82\x97\xf8\x9e\x5f\xf8\x94\xdf\x04\x00\x12\x00\x00\x00\xc0\xb8" +
    b"\x40\x11\x04\xc1\x49\x10\x04\x41\x41\x04\x41\x10\xc4\x41\x10\x04" +
    b"\xc1\x1f\x7c\xc0\x37\xfd\xc6\x07\xfc\x26\x00\x90\x00\x00\x00\x00" +
    b"\xc6\x07\x0a\x82\x20\x38\x88\x20\x08\xa2\x38\x08\x82\x20\x38\x09" +
    b"\x82\x20\xf8\x81\x1f\xf9\x96\x9b\x0f\xf9\x4d\x80\x00\x01\x00\x00" +
    b"\x00\xac\xbf\xc5\xcb\x0d\x4d\x22\xfe\xff\xbc\xf7\x3e\x86\x88\x73" +
    b"\x0e\x82\xf7\x78\xef\x8d\x11\x0a\xce\x18\x04\xe7\x90\x42\x40\x49" +
    b"\x89\xd8\x54\x8d\xd2\xb0\xda\xc0\x19\x0b\x6f\x1d\x82\x0b\x60\x94" +
    b"\x20\xc5\x84\x9c\x32\x4a\x2e\xa8\xa5\xa2\xd5\x06\x46\x09\x7a\xef" +
    b"\x18\x63\x60\xce\x89\xb5\x16\xf6\xde\x00\x00\x00\x00\x00",
  )
  @test.assert_eq(image.width, 6)
  @test.assert_eq(image.height, 5)
  @test.assert_eq(image.pixels, [
    0xff112233U, 0x00040506U, 0xff778899U, 0xffaabbccU, 0xff102030U, 0xff405060U,
    0x80ddeeffU, 0xff111213U, 0xff141516U, 0xff171819U, 0xff1a1b1cU, 0xff1d1e1fU,
    0xff202122U, 0xff232425U, 0xff262728U, 0xff292a2bU, 0xff2c2d2eU, 0xff2f3031U,
    0xff323334U, 0xff353637U, 0xff38393aU, 0xff3b3c3dU, 0xff3e3f40U, 0xff414243U,
    0xff444546U, 0xff474849U, 0xff4a4b4cU, 0xff4d4e4fU, 0xff505152U, 0xff535455U,
  ])
}

///|
test "applies the cross color transform" {
  let image = @webp.decode_vp8l(
    b"\x2f\x03\x80\x00\x10\x83\x82\x14\xa2\xe0\xfd\x0f\xf8\x4d\x00\x04" +
    b"\x01\x00\x00\x00\x25\xd9\xbe\xe1\x29\x9e\xe0\x47\xbe\xe2\x09\x9e" +
    b"\xe6\x07\xbe\xe1\x37\x01\x10\x04\x00\x00\x00\x14\x64\xfb\x86\x27" +
    b"\x78\x8a\x27\x78\x92\x27\x7a\x89\xfa\x4d\x80\x00\x01\x00\x00\x00" +
    b"\xd3\xba\x39\x7a\x92\xa7\xf8\xaa\x1f\x79\x82\xdf\x04\x01\x10\x00" +
    b"\x00\x00\x30\xa4\x9f\xfb\xb9\x11\xa9\x6b\xfe\x56\xfa\x23\x7d\x9b" +
    b"\x98\xdf\xea\x7f\xfe\xc7\x01\x70\xb6\x9f\xe8\x00\x00\x00\x00\x00",
  )
  @test.assert_eq(image.width, 4)
  @test.assert_eq(image.height, 3)
  @test.assert_eq(image.pixels, [
    0xff102030U, 0xff405060U, 0x80a0b0c0U, 0x00ffffffU, 0xff7f7f7fU, 0xff010203U,
    0xfff0f0f0U, 0xff00ff00U, 0xffffffffU, 0xff000000U, 0xff204060U, 0xff80a0c0U,
  ])
}

///|
test "expands a color indexing transform" {
  let image = @webp.decode_vp8l(
    b"\x2f\x04\x80\x00\x10\x17\xe0\x37\x41\x00\x04\x00\x00\x00\xf0\x14" +
    b"\x4f\xf6\x34\xcf\xf3\x9b\x20\x00\x02\x00\x00\x00\x78\x82\x1f\xfa" +
    b"\x92\x27\xfb\x4d\x10\x00\x01\x00\x00\x00\x3c\xc9\x13\x3c\xd1\x93" +
    b"\xfd\x26\x08\x80\x00\x00\x00\x00\x9e\xae\x97\x1b\xea\x7d\x97\xf0" +
    b"\x9b\x00\x01\x02\x00\x00\x00\x58\xa7\xf8\x8c\xef\x79\x7d\x44\xff" +
    b"\xa3\x3c\x66\x00\x00\x00\x00\x00",
  )
  @test.assert_eq(image.width, 5)
  @test.assert_eq(image.height, 3)
  @test.assert_eq(image.pixels, [
    0xff102030U, 0x80a0b0c0U, 0x00ff8000U, 0xff102030U, 0x80a0b0c0U, 0x00ff8000U,
    0xff102030U, 0x80a0b0c0U, 0x00ff8000U, 0xff102030U, 0x80a0b0c0U, 0x00ff8000U,
    0xff102030U, 0x80a0b0c0U, 0x00000000U,
  ])
}

///|
test "undoes stacked color indexing and predictor transforms" {
  let image = @webp.decode_vp8l(
    b"\x2f\x04\xc0\x00\x10\x27\xe0\x37\x01\x02\x04\x00\x00\x00\x30\x1e" +
    b"\xf2\x44\x4f\xf4\x23\xdf\xf0\x9b\x00\x01\x02\x00\x00\x00\x58\x87" +
    b"\x78\xaa\x9f\xfa\x8a\xdf\x04\x08\x10\x00\x00\x00\xc0\x78\xcc\xd7" +
    b"\xfc\xcc\xcf\xf4\x9b\x04\x00\x02\x00\x00\x00\xf8\xff\xd3\x46\x9a" +
    b"\xfb\x9c\x40\x5c\x57\x81\xe8\x41\x07\xfa\x1f\xf0\x9b\x00\x01\x02" +
    b"\x00\x00\x00\x88\x1f\x78\x8b\x27\xe8\xff\xa7\x08\x7e\x13\x11\x01" +
    b"\x1d\xa2\x8b\x05\x00\x00\x00\x00",
  )
  @test.assert_eq(image.width, 5)
  @test.assert_eq(image.height, 4)
  @test.assert_eq(image.pixels, [
    0xff203040U, 0xff203040U, 0xffff0000U, 0xffff0000U, 0xff00ff00U, 0xff203040U,
    0xff203040U, 0xffff0000U, 0xffff0000U, 0xff00ff00U, 0xff0000ffU, 0xff0000ffU,
    0xff808080U, 0xff808080U, 0xff203040U, 0xffff0000U, 0xff00ff00U, 0xff0000ffU,
    0xff808080U, 0xff203040U,
  ])
}
