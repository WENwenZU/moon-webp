  b"\x87\x36\x56\x50\x38\x20\x66\x00\x00\x00\xd0\x01\x00\x9d\x01\x2a" +
  b"\x0d\x00\x0b\x00\x02\x00\x34\x25\xb0\x02\x74\x00\xdc\x0a\x8a\x25" +
  b"\x80\x00\xfe\xfb\x7d\x52\x21\xa4\xff\x5b\xad\xf3\x07\xbb\xbc\x7b" +
  b"\xcd\x81\x0e\x67\x6f\xaa\xf5\xbd\x3b\xf6\x0a\x3e\x15\x29\xb8\x7e" +
  b"\xab\x5d\x7f\xca\xe9\x1e\x54\xaf\xf6\x89\x15\x80\xff\xf9\xc0\x5f" +
  b"\xc6\x97\xa2\xd7\xee\x0d\x7f\xc0\x8c\x1e\x4d\xfe\xd3\x3c\x99\xf4" +
  b"\x47\x6b\x6d\xfe\xff\xe3\xfe\xff\xfe\x6f\x13\xdb\x27\x00\x00\x00"

///|
let a_m1_f3 : Bytes = b"\x52\x49\x46\x46\xba\x00\x00\x00\x57\x45\x42\x50\x56\x50\x38\x58" +
  b"\x0a\x00\x00\x00\x10\x00\x00\x00\x0c\x00\x00\x0a\x00\x00\x41\x4c" +
  b"\x50\x48\x2e\x00\x00\x00\x09\x77\xa0\xa6\x6d\x03\x26\x5f\xc7\x5b" +
  b"\xfe\x74\x8b\x21\x22\x92\x55\x17\x0a\x21\x59\xa1\x26\x81\xf7\x51" +
  b"\x89\x25\x96\x58\x62\x89\x25\xa3\x04\x22\xfa\x1f\xb2\x6d\x47\x56" +
  b"\xcf\x1e\xde\x01\x56\x50\x38\x20\x66\x00\x00\x00\xd0\x01\x00\x9d" +
  b"\x01\x2a\x0d\x00\x0b\x00\x02\x00\x34\x25\xb0\x02\x74\x00\xdc\x0a" +
  b"\x8a\x25\x80\x00\xfe\xfb\x7d\x52\x21\xa4\xff\x5b\xad\xf3\x07\xbb" +
  b"\xbc\x7b\xcd\x81\x0e\x67\x6f\xaa\xf5\xbd\x3b\xf6\x0a\x3e\x15\x29" +
  b"\xb8\x7e\xab\x5d\x7f\xca\xe9\x1e\x54\xaf\xf6\x89\x15\x80\xff\xf9" +
  b"\xc0\x5f\xc6\x97\xa2\xd7\xee\x0d\x7f\xc0\x8c\x1e\x4d\xfe\xd3\x3c" +
  b"\x99\xf4\x47\x6b\x6d\xfe\xff\xe3\xfe\xff\xfe\x6f\x13\xdb\x27\x00" +
  b"\x00\x00"

///|
let broken_form : Bytes = b"\x52\x49\x46\x46\x04\x00\x00\x00\x57\x45\x42\x51"

///|
let no_image : Bytes = b"\x52\x49\x46\x46\x16\x00\x00\x00\x57\x45\x42\x50\x56\x50\x38\x58" +
  b"\x0a\x00\x00\x00\x00\x00\x00\x00\x0c\x00\x00\x0a\x00\x00"

///|
let bad_vp8x_size : Bytes = b"\x52\x49\x46\x46\x6e\x00\x00\x00\x57\x45\x42\x50\x56\x50\x38\x58" +
  b"\x08\x00\x00\x00\x00\x00\x00\x00\x0c\x00\x00\x0a\x56\x50\x38\x4c" +
  b"\x52\x00\x00\x00\x2f\x0c\x80\x02\x10\xb9\x8c\xe8\x7f\xec\xea\x50" +
  b"\x86\x22\xf4\x3f\x1c\x86\x12\x46\x11\x4e\xad\x60\xff\xac\xc2\x3a" +
  b"\xec\x27\x10\x48\xf1\x0a\x21\x1c\x4a\x23\x59\xad\x65\x0d\x35\xe0" +
  b"\xfe\xe0\x70\x38\x1c\x2e\x2e\x2e\x2e\x59\x41\x20\x5e\x1a\x84\x46" +
  b"\x7e\x95\x7b\x46\xfe\xa5\x51\x68\x34\x1a\x83\xc6\xa2\x71\xd0\xb8" +
  b"\x78\x69\x3c\x34\x3e\x02"

///|
let canvas_mismatch : Bytes = b"\x52\x49\x46\x46\x70\x00\x00\x00\x57\x45\x42\x50\x56\x50\x38\x58" +
  b"\x0a\x00\x00\x00\x10\x00\x00\x00\x0b\x00\x00\x0a\x00\x00\x56\x50" +
  b"\x38\x4c\x52\x00\x00\x00\x2f\x0c\x80\x02\x10\xb9\x8c\xe8\x7f\xec" +
  b"\xea\x50\x86\x22\xf4\x3f\x1c\x86\x12\x46\x11\x4e\xad\x60\xff\xac" +
  b"\xc2\x3a\xec\x27\x10\x48\xf1\x0a\x21\x1c\x4a\x23\x59\xad\x65\x0d" +
  b"\x35\xe0\xfe\xe0\x70\x38\x1c\x2e\x2e\x2e\x2e\x59\x41\x20\x5e\x1a" +
  b"\x84\x46\x7e\x95\x7b\x46\xfe\xa5\x51\x68\x34\x1a\x83\xc6\xa2\x71" +
  b"\xd0\xb8\x78\x69\x3c\x34\x3e\x02"

///|
/// A `VP8X` canvas of 2^24 by 2^24 pixels: more than 2^32 pixels in total,
/// which no array can address.
let canvas_too_large : Bytes = b"\x52\x49\x46\x46\x16\x00\x00\x00\x57\x45\x42\x50\x56\x50\x38\x58" +
  b"\x0a\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff"

///|
/// A simple-format file whose first chunk is `ALPH` rather than an image.
let alpha_first : Bytes = b"\x52\x49\x46\x46\x10\x00\x00\x00\x57\x45\x42\x50\x41\x4c\x50\x48" +
  b"\x04\x00\x00\x00\x00\x00\x00\x00"

///|
test "decodes a simple-format lossless file" {
  let image = @webp.decode_webp(simple_file)
  @test.assert_eq(image.width, 13)
  @test.assert_eq(image.height, 11)
  @test.assert_eq(image.pixels, lossless_pixels)
}

///|
test "decodes an extended file and skips its metadata chunks" {
  let image = @webp.decode_webp(extended_file)
  @test.assert_eq(image.width, 13)
  @test.assert_eq(image.pixels, lossless_pixels)
  let info = @webp.webp_info(extended_file)
  @test.assert_eq(info.width, 13)
  @test.assert_eq(info.height, 11)
  @test.assert_eq(info.has_alpha, true)
  @test.assert_eq(info.has_animation, false)
  @test.assert_eq(info.is_lossless, true)
}

///|
test "decodes an uncompressed alpha plane" {
  let plane = @webp.decode_alpha(a_m0_f0)
  @test.assert_eq(plane.width, 13)
  @test.assert_eq(plane.height, 11)
  @test.assert_eq(plane.values, alpha_plane)
}

///|
test "undoes the horizontal, vertical, and gradient alpha filters" {
  let filtered = [a_m0_f1, a_m0_f2, a_m0_f3]
  for file in filtered {
    @test.assert_eq(@webp.decode_alpha(file).values, alpha_plane)
  }
}

///|
test "decodes a compressed alpha plane" {
  @test.assert_eq(@webp.decode_alpha(a_m1_f0).values, alpha_plane)
  @test.assert_eq(@webp.decode_alpha(a_m1_f3).values, alpha_plane)
}

///|
test "reports a lossy image without decoding its pixels" {
  let info = @webp.webp_info(a_m0_f0)
  @test.assert_eq(info.width, 13)
  @test.assert_eq(info.height, 11)
  @test.assert_eq(info.has_alpha, true)
  @test.assert_eq(info.is_lossless, false)
  let err = @test.expect_error(() => @webp.decode_webp(a_m0_f0))
  @test.assert_eq(err, @webp.DecodeError::UnsupportedLossyImage)
}

///|
test "rejects an alpha request on a lossless file" {
  let err = @test.expect_error(() => @webp.decode_alpha(extended_file))
  @test.assert_eq(err, @webp.DecodeError::MissingAlphaChunk)
}

///|
test "rejects a non-WebP RIFF form" {
  let err = @test.expect_error(() => @webp.webp_info(broken_form))
  @test.assert_eq(err, @webp.DecodeError::InvalidRiffForm)
}

///|
test "rejects a header without an image chunk" {
  let err = @test.expect_error(() => @webp.decode_webp(no_image))
  @test.assert_eq(err, @webp.DecodeError::MissingImageChunk)
}

///|
test "rejects a VP8X chunk that is not ten bytes long" {
  let err = @test.expect_error(() => @webp.decode_webp(bad_vp8x_size))
  @test.assert_eq(err, @webp.DecodeError::InvalidVp8xChunk(8U))
}

///|
test "rejects a canvas that disagrees with the image chunk" {
  let err = @test.expect_error(() => @webp.decode_webp(canvas_mismatch))
  @test.assert_eq(err, @webp.DecodeError::CanvasSizeMismatch)
}

///|
test "reports the alpha hint of a simple-format file" {
  let info = @webp.webp_info(simple_file)
  @test.assert_eq(info.width, 13)
  @test.assert_eq(info.height, 11)
  @test.assert_eq(info.has_alpha, true)
  @test.assert_eq(info.has_animation, false)
  @test.assert_eq(info.is_lossless, true)
}

///|
test "rejects a canvas that cannot be addressed" {
  let err = @test.expect_error(() => @webp.webp_info(canvas_too_large))
  @test.assert_eq(err, @webp.DecodeError::CanvasTooLarge)
}

///|
test "rejects a simple-format file that starts with a non-image chunk" {
  let err = @test.expect_error(() => @webp.decode_webp(alpha_first))
  @test.assert_eq(err, @webp.DecodeError::InvalidChunkOrder)
}
